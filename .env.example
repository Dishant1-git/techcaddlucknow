# Local secrets — ignored by git. Restart `npm run dev` after editing.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Nidhi@100703
DB_NAME=techcaddlucknow
# MySQL is on this machine, so no TLS is needed.
DB_SSL=false

# --- CMS (cms-techcadd/backend) ---------------------------------------------
# Where the site reads content from. Unset or unreachable, every section falls
# back to the content bundled with the site.
CMS_URL=http://localhost:4000
# Where browsers load CMS uploads from, when it differs from CMS_URL.
# CMS_PUBLIC_URL=https://cms.techcaddlucknow.com
# Shared with the CMS's REVALIDATE_SECRET, so a publish shows immediately.
REVALIDATE_SECRET=generate-a-long-random-string
# The CMS admin's address: the only page allowed to frame /preview (live preview).
# NEXT_PUBLIC_CMS_ADMIN_ORIGIN=https://cms.techcaddlucknow.com
# This site's public address, for canonical links and /sitemap.xml.
# SITE_URL=https://techcaddlucknow.com
